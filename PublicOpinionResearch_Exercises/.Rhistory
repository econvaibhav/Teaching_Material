library(ggplot2)
library(ggflags)
# 1. Create a tiny dataset
data <- data.frame(
x = 1:3,
y = 1:3,
country = c("us", "br", "jp") # Must be lowercase 2-letter codes
)
# 2. Plot using geom_flag()
ggplot(data, aes(x, y, country = country)) +
geom_flag(size = 15) +
theme_minimal()
library(ggplot2)
library(ggflags)
# 1. More realistic "professional" data
data <- data.frame(
gdp_growth = c(2.1, 3.4, 1.8, 4.2, 2.9),
happiness_score = c(7.2, 6.1, 7.8, 5.4, 6.9),
country = c("us", "br", "jp", "in", "de"),
name = c("United States", "Brazil", "Japan", "India", "Germany")
)
# 2. The Professional Plot
ggplot(data, aes(x = gdp_growth, y = happiness_score, country = country)) +
# Add flags (larger and slightly transparent if they overlap)
geom_flag(size = 12) +
# Add text labels so people don't have to guess the flags
geom_text(aes(label = name), vjust = -2, size = 3.5, fontface = "italic") +
# Professional Scales & Titles
labs(
title = "Economic Growth vs. National Happiness (2026)",
subtitle = "Comparing key global economies using ISO-standard flag markers",
x = "GDP Growth (%)",
y = "Happiness Index Score",
caption = "Source: Simulated Global Data | Package: ggflags"
) +
# Clean, modern theme
theme_minimal(base_family = "sans") +
theme(
plot.title = element_text(face = "bold", size = 16),
plot.subtitle = element_text(color = "grey40", margin = margin(b = 20)),
panel.grid.minor = element_blank(),
axis.title = element_text(face = "bold")
)
