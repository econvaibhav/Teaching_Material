desc_stats <- ESS_Cleaned %>%
select(where(is.numeric)) %>% # Only grab the numeric columns!
select(-idno) %>%             # Remove the ID number, as its mean is meaningless
pivot_longer(everything(), names_to = "Variable", values_to = "Value") %>%
drop_na() %>%                 # Drop NAs so math functions work
group_by(Variable) %>%
summarise(
N = n(),
Mean = round(mean(Value), 2),
SD = round(sd(Value), 2),
Median = median(Value),
Min = min(Value),
Max = max(Value)
) %>%
arrange(Variable)
# 2. Render as a professional table
desc_stats %>%
kbl(
booktabs = TRUE,
caption = "Descriptive Statistics for Numeric Variables",
format = "html",
align = c("l", "c", "c", "c", "c", "c", "c") # Left align names, center align math
) %>%
kable_styling(
bootstrap_options = c("striped", "hover", "condensed"),
full_width = FALSE,
position = "center"
) %>%
row_spec(0, bold = TRUE, color = "white", background = "#4CAF50") %>% # Highlight header
column_spec(1, bold = TRUE) %>% # Bold variable names
footnote(
general = "Data source: European Social Survey (ESS).",
general_title = ""
)
