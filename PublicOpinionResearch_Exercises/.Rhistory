install.packages("ggthemes")
library(tidyverse)
library(scales)
library(patchwork)
# Filtering and mutating the raw dataset
ESS_Cleaned <- ESS_Subset %>%
filter(
agea < 100,             # Remove 999 (No answer)
eduyrs <= 30,           # Remove 77, 88, 99 codes
lrscale <= 10,          # Remove 77, 88 codes
imwbcnt <= 10,          # Remove 77, 88, 99 codes
imbgeco <= 10,          # Remove 77, 88 codes
imueclt <= 10,          # Remove 77, 88 codes
trstplc <= 10,          # Remove 77, 88 codes
trstprl <= 10,          # Remove 77, 88 codes
polintr <= 4            # Remove 7, 8 codes
) %>%
mutate(
Country = case_when(
cntry == "DE" ~ "Germany",
cntry == "HU" ~ "Hungary",
cntry == "SE" ~ "Sweden",
TRUE ~ cntry
),
Gender = factor(gndr, levels = c(1, 2), labels = c("Male", "Female")),
PolInterest = factor(polintr, levels = c(1, 2, 3, 4),
labels = c("Very", "Quite", "Hardly", "Not at all"))
)
# Making the new "Trust" Variables
ESS_Cleaned <- ESS_Cleaned %>%
mutate(Trust_Police_New = case_when(
trstplc %in% c(0,1,2,3) ~ "Low Trust",
trstplc %in% c(4,5,6,7) ~ "Moderate Trust",
trstplc %in% c(8,9,10) ~ "High Trust",
TRUE      ~ NA_character_
)) %>%
mutate(Trust_Parli_New = case_when(
trstprl %in% c(0,1,2,3) ~ "Low Trust",
trstprl %in% c(4,5,6,7) ~ "Moderate Trust",
trstprl %in% c(8,9,10) ~ "High Trust",
TRUE      ~ NA_character_
))
# Aggregating data for the Police Trust plot
PolTrust <- ESS_Cleaned %>%
dplyr::select(Trust_Police_New, PolInterest, Country) %>%
na.omit() %>%
group_by(Trust_Police_New, PolInterest, Country) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(Country, PolInterest) %>%
mutate(prop = n / sum(n))
ParTrust <- ESS_Cleaned %>%
dplyr::select(Trust_Parli_New, PolInterest, Country) %>%
na.omit() %>%
group_by(Trust_Parli_New, PolInterest, Country) %>%
summarise(n = n(), .groups = "drop") %>%
group_by(Country, PolInterest) %>%
mutate(prop = n / sum(n))
ggplot(PolTrust,
aes(x = factor(PolInterest),
y = prop,
fill = factor(Trust_Police_New, levels = c("Low Trust", "Moderate Trust", "High Trust")))) +
geom_col() +
geom_text(aes(label = scales::percent(prop, accuracy = 1)),
position = position_stack(vjust = 0.5),
size = 3) +
scale_y_continuous(labels = scales::percent) +
labs(
x = "",
y = "Percentage of Respondents",
title = "Trust and Political Interest",
subtitle = "Police",
fill = 'Trust in Police'
) +
scale_fill_manual(values=c('#FF5555','#CAEEC2','#C1E59F')) +
theme_bw() +
theme_graphs +
theme(#axis.text.x = element_text(angle = 360, vjust = 1, hjust = 1),
legend.position = "none") +
facet_wrap(~ Country)
theme_graphs <- theme(
axis.text.x = element_text(face = "bold"),
axis.title.x = element_text(color = "black", size = 10, face = "bold"),
axis.title.y = element_text(color = "black", size = 10, face = "bold"),
plot.title = element_text(color = "black", size = 12, hjust = 0.5),
plot.subtitle = element_text(color = "black", size = 8, hjust = 0.5),
plot.caption = element_text(face = "italic"),
legend.position = 'bottom'
)
ggplot(PolTrust,
aes(x = factor(PolInterest),
y = prop,
fill = factor(Trust_Police_New, levels = c("Low Trust", "Moderate Trust", "High Trust")))) +
geom_col() +
geom_text(aes(label = scales::percent(prop, accuracy = 1)),
position = position_stack(vjust = 0.5),
size = 3) +
scale_y_continuous(labels = scales::percent) +
labs(
x = "",
y = "Percentage of Respondents",
title = "Trust and Political Interest",
subtitle = "Police",
fill = 'Trust in Police'
) +
scale_fill_manual(values=c('#FF5555','#CAEEC2','#C1E59F')) +
theme_bw() +
theme_graphs +
theme(#axis.text.x = element_text(angle = 360, vjust = 1, hjust = 1),
legend.position = "none") +
facet_wrap(~ Country)
ggplot(PolTrust,
aes(x = factor(PolInterest),
y = prop,
fill = factor(Trust_Police_New, levels = c("Low Trust", "Moderate Trust", "High Trust")))) +
geom_col() +
geom_text(aes(label = scales::percent(prop, accuracy = 1)),
position = position_stack(vjust = 0.5),
size = 3) +
scale_y_continuous(labels = scales::percent) +
labs(
x = "",
y = "Percentage of Respondents",
title = "Trust and Political Interest",
subtitle = "Police",
fill = 'Trust in Police'
) +
scale_fill_manual(values=c('#FF5555','#CAEEC2','#C1E59F')) +
theme_bw() +
theme_graphs +
theme(#axis.text.x = element_text(angle = 360, vjust = 1, hjust = 1),
legend.position = "none") +
facet_grid(~ Country)
install.packages("ggdag")
library(ggdag)
install.packages('dagitty')
install.packages("ggdag")
library(ggdag)
install.packages('V8')
install.packages("DiagrammeR")
library(DiagrammeR)
grViz("
digraph simple_dag {
# 1. Set global graph, node, and edge attributes
graph [layout = dot, rankdir = LR] # LR means Left-to-Right layout
node [shape = circle, style = filled, fillcolor = lightblue, fontname = Helvetica]
edge [color = gray30, arrowhead = vee]
# 2. Define the edges (arrows)
A -> B
A -> C
B -> D
C -> D
# Optional: Add a standalone node or force a specific rank
E -> D
}
")
# 1. Set the environment variable to download a static build
Sys.setenv(DOWNLOAD_STATIC_LIBV8 = 1)
# 2. Re-try the installation
install.packages("ggdag")
install.packages("ggdag")
library(ggdag)
library(ggplot2) # For extra formatting
# Define the relationships
# y is caused by x and z; x is caused by z
my_dag <- dagify(
y ~ x + z,
x ~ z,
exposure = "x",
outcome = "y",
labels = c("y" = "Outcome", "x" = "Treatment", "z" = "Confounder")
)
# Plot the DAG
ggdag(my_dag, text = FALSE, use_labels = "label") +
theme_dag() + # Removes the background grid
ggtitle("My Causal DAG")
ggdag(my_dag, text = FALSE) +
geom_dag_node(aes(color = color), size = 24) +             # Bigger nodes
geom_dag_text(aes(label = label), color = "white", size = 4) + # Centered inside
geom_dag_edges() +
theme_dag() +
theme(legend.position = "none") +                          # Hides auto-generated legend
ggtitle("My Causal DAG")
# Define the relationships
# y is caused by x and z; x is caused by z
my_dag <- dagify(
y ~ x + z,
x ~ z,
exposure = "x",
outcome = "y",
labels = c("y" = "Outcome", "x" = "Treatment", "z" = "Confounder")
)
ggdag(my_dag, text = FALSE) +
geom_dag_node(aes(color = color), size = 24) +             # Bigger nodes
geom_dag_text(aes(label = label), color = "white", size = 4) + # Centered inside
geom_dag_edges() +
theme_dag() +
theme(legend.position = "none") +                          # Hides auto-generated legend
ggtitle("My Causal DAG")
library(ggdag)
library(ggplot2)
# Define your DAG
my_dag <- dagify(
y ~ x + z,
x ~ z,
exposure = "x",
outcome = "y",
labels = c("y" = "Outcome", "x" = "Treatment", "z" = "Confounder")
)
# Plot with custom geometry layers
ggdag(my_dag, text = FALSE) +
geom_dag_node(color = "steelblue", size = 26) +              # Solid node color & size
geom_dag_text(aes(label = label), color = "white", size = 4) + # Centered text label
geom_dag_edges() +                                            # Add arrows
theme_dag() +                                                 # Clean layout
ggtitle("My Causal DAG")
ggdag(my_dag, text = FALSE) +
geom_dag_node(color = "steelblue", size = 20) +              # Solid node color & size
geom_dag_text(aes(label = label), color = "white", size = 4) + # Centered text label
geom_dag_edges() +                                            # Add arrows
theme_dag() +                                                 # Clean layout
ggtitle("My Causal DAG")
ggdag(my_dag, text = FALSE) +
geom_dag_node(color = "steelblue", size = 26) +              # Solid node color & size
geom_dag_text(aes(label = label), color = "white", size = 3) + # Centered text label
geom_dag_edges() +                                            # Add arrows
theme_dag() +                                                 # Clean layout
ggtitle("My Causal DAG")
ggdag(my_dag, text = FALSE) +
geom_dag_node(color = "black", size = 26) +              # Solid node color & size
geom_dag_text(aes(label = label), color = "white", size = 3) + # Centered text label
geom_dag_edges() +                                            # Add arrows
theme_dag() +                                                 # Clean layout
ggtitle("My Causal DAG")
# Plot with custom geometry layers
ggdag(my_dag, text = FALSE) +
geom_dag_node(color = "black", size = 26) +              # Solid node color & size
geom_dag_text(aes(label = label), color = "white", size = 3) + # Centered text label
geom_dag_edges() +                                            # Add arrows
theme_bw() +                                                 # Clean layout
ggtitle("My Causal DAG")
