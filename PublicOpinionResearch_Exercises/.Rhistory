# 1. Read an image (can be a URL!)
tiger <- image_read("https://jeroen.github.io/images/tiger.svg")
# 2. Apply fun filters
tiger_styled <- tiger %>%
image_charcoal() %>%          # Turn into a sketch
image_annotate("Sketch Mode", size = 50, color = "red", boxcolor = "pink", gravity = "north") %>%
image_rotate(15)
# 3. View it
print(tiger_styled)
