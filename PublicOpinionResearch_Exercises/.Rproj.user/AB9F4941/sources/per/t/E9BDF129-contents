   "source": [
    "# don't forget to change the environment from top right to our new environment Python(tobii_env)\n",
    "# this is how we are going to access our eye tracker\n",
    "# Documentation:\n",
    "# https://devtobiipro.azurewebsites.net/tobii.research/python/reference/1.6.0.97-alpha-g11c409a/classtobii__research_1_1EyeTracker.html\n",
    "\n",
    "\n",
    "\n",
    "import sys\n",
    "!{sys.executable} -m pip install tobii-research"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "32321cce-66b2-49ae-b123-395eb227163a",
   "metadata": {},
   "outputs": [],
   "source": [
    "# connect the eye tracker, if any, and print its info\n",
    "import tobii_research as tr\n",
    "\n",
    "eyetrackers = tr.find_all_eyetrackers()\n",
    "if len(eyetrackers) == 0:\n",
    "    print(\"No eye tracker found\")\n",
    "else:\n",
    "    eyetracker = eyetrackers[0]\n",
    "    print(\"Model: \" + eyetracker.model)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "75c055ea-aefc-4eb0-b6c2-164f23ae0675",
   "metadata": {},
   "source": [
    "## Task 2 — Inspect Gaze Data\n",
    "\n",
    "### Objective:\n",
    "Understand what gaze data looks like.\n",
    "\n",
    "### Instructions:\n",
    "\n",
    "1. Create a callback function\n",
    "2. Print gaze data values:\n",
    "3. Subscribe to gaze data stream\n",
    "\n",
    "### Observe:\n",
    "- How often does gaze data update?\n",
    "- What happens when you blink?\n",
    "- Do values stay stable or fluctuate?"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "640a1fe0-9f57-47f3-ad0b-025124fa6fec",
   "metadata": {
    "scrolled": true
   },
   "outputs": [],
   "source": [
    "def print_gaze_callback(gaze_data):\n",
    "    left = gaze_data[\"left_gaze_point_on_display_area\"]\n",
    "    right = gaze_data[\"right_gaze_point_on_display_area\"]\n",
    "\n",
    "    left_pupil = gaze_data[\"left_pupil_diameter\"]\n",
    "    right_pupil = gaze_data[\"right_pupil_diameter\"]\n",
    "\n",
    "    timestamp = gaze_data[\"device_time_stamp\"]\n",
    "\n",
    "    left_valid = gaze_data[\"left_gaze_point_validity\"]\n",
    "    right_valid = gaze_data[\"right_gaze_point_validity\"]\n",
    "\n",
    "    print(\n",
    "        \"Left:\", left,\n",
    "        \"| Right:\", right,\n",
    "        \"| Left pupil:\", left_pupil,\n",
    "        \"| Right pupil:\", right_pupil,\n",
    "        \"| Validity:\", left_valid, right_valid,\n",
    "        \"| Time:\", timestamp\n",
    "    )\n",
    "\n",
    "eyetracker.subscribe_to(\n",
    "    tr.EYETRACKER_GAZE_DATA,\n",
    "    print_gaze_callback,\n",
    "    as_dictionary=True\n",
    ")\n",
    "\n",
    "print(\"Streaming gaze data... run teh next cell to stop the data stream.\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "7b1a9bfc-dd62-495d-978e-0e89c81b4f3d",
   "metadata": {},
   "outputs": [],
   "source": [
    "# don't forget to stop the call, otherwise it will keep looong forever. Do this every time you subscribe to a data stream\n",
    "eyetracker.unsubscribe_from(\n",
    "    tr.EYETRACKER_GAZE_DATA,\n",
    "    print_gaze_callback\n",
    ")\n",
    "\n",
    "print(\"Stopped printing gaze data.\")"
   ]
  },
